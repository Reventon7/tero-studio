{
  "framework": null,
  "cleanUrls": true,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/:dir*/:file([a-z0-9-]+-v[0-9]+\\.(?:webp|jpg|png|svg))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:file(app|hero-film|navigation|catalog-page|style|catalog|lens).:ext(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=60" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, max-age=300, stale-while-revalidate=60" }
      ]
    },
    {
      "source": "/fonts/fonts.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=60" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, max-age=300, stale-while-revalidate=60" }
      ]
    },
    {
      "source": "/assets/:dir(hero-magnific-hd-48|dentist-final-48)/:file(scrub-[0-9]+-[a-z0-9-]*v[0-9]+\\.mp4)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/models/:file([a-z0-9-]+-v[0-9]+\\.glb)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/:file(font-[0-9]+-v[0-9]+\\.woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/bundles/:file([a-z]+-[A-Z0-9]+\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
